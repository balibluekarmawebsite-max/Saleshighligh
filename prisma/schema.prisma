// BK Sales Dashboard — Prisma schema (Phase 1)
//
// Database: self-hosted PostgreSQL (local to the VPS) for all environments.
//   - DATABASE_URL: the app's runtime connection.
//   - DIRECT_URL:   used by Prisma Migrate. Same value as DATABASE_URL for a
//                   plain local Postgres (no external connection pooler).
//
// Modelling principles (see CLAUDE.md):
//   - Everything is keyed by (propertyId, period) where `period` is the first
//     day of the month (a Date). ReportPeriod is the parent of a month's data.
//   - Store only RAW inputs. All derived metrics (variance, achievement %,
//     RevPAR, ROAS, average check, MoM, YTD accumulation) are computed in
//     lib/calculations.ts — never persisted.
//   - Money and rates are Decimal (Postgres numeric); counts are Int;
//     ratios/percentages are Decimal. IDR values have no minor units in
//     practice but Decimal keeps parsing/aggregation exact.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum ReportStatus {
  DRAFT
  FINAL
}

enum Scope {
  MTD
  YTD
}

enum Series {
  ACTUAL
  BUDGET
  LAST_YEAR
}

enum Department {
  OCCUPANCY
  ADR
  REVPAR
  ROOM_REVENUE
  FNB
  SPA_WELLNESS
  GALLERY
  OOD
  TOTAL_REVENUE
}

enum AccountType {
  OTA
  TA
  CORPORATE
  WHOLESALER
}

enum BusinessUnit {
  HOTEL
  RESTAURANT
  SPA
}

enum AdsPlatform {
  GOOGLE
  META
  CORPORATE
}

enum MealPeriod {
  BREAKFAST
  LUNCH
  DINNER
}

enum FnbChannel {
  WALK_IN
  REPEATER
  CHOPE
  CATERING
}

enum SpaGuestSegment {
  IN_HOUSE
  OUTSIDE
  INCLUSION
}

enum RankingPlatform {
  BOOKING
  EXPEDIA
  TRIPADVISOR
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
}

enum NarrativeSection {
  SUMMARY
  EXTERNAL_FACTORS
  INTERNAL_FACTORS
  ROOMTYPE_ANALYSIS
  RESTAURANT_OVERVIEW
  SPA_OVERVIEW
  MARKET_INTEL
  SALES_STRATEGY
  ACTION_PLAN
  MARKETING_PLAN
  SOCIAL_PLAN
  CONSORTIA
  MAGAZINE
  PR
  PROMOTIONS
}

// ─── Core ─────────────────────────────────────────────────────────────────

/// The three Blue Karma properties.
model Property {
  id             String   @id @default(cuid())
  /// Short code: "BKDS", "BKDU", or "BKV".
  code           String   @unique
  name           String
  restaurantName String
  spaName        String
  roomCount      Int
  area           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  periods       ReportPeriod[]
  importHistory ImportHistory[]
  exportHistory ExportHistory[]

  // Weekly Reports module (shares the same properties)
  weeklyReports        WeeklyReport[]
  weeklyBudgets        WeeklyBudget[]
  weeklyMarketSegments WeeklyMarketSegment[]
  weeklyRateCodes      WeeklyRateCode[]
  weeklyChannels       WeeklyChannel[]
  weeklySettings       WeeklySetting[]
  weeklyImports        WeeklyImport[]

  @@map("properties")
}

/// One month of data for one property — the parent of every section below.
model ReportPeriod {
  id         String       @id @default(cuid())
  propertyId String
  /// First day of the reported month (e.g. 2026-06-01).
  period     DateTime     @db.Date
  status     ReportStatus @default(DRAFT)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  revenueSummaries   RevenueSummary[]
  segmentProduction  SegmentProduction[]
  roomTypeProduction RoomTypeProduction[]
  nationality        NationalityProduction[]
  lengthOfStay       LengthOfStay[]
  accountProduction  AccountProduction[]
  adsPerformance     AdsPerformance[]
  fnbSales           FnbSales[]
  fnbSources         FnbSourceOfBooking[]
  fnbAcquisition     FnbAcquisition[]
  chopeReports       ChopeReport[]
  gokaiReports       GokaiReport[]
  spaSales           SpaSales[]
  spaTreatments      SpaTreatment[]
  platformRankings   PlatformRanking[]
  tripadvisorMetrics TripadvisorMetrics[]
  socialMediaMetrics SocialMediaMetrics[]
  bookingPace        BookingPace[]
  forecasts          Forecast[]
  marketSupply       MarketSupply[]
  narrativeContent   NarrativeContent[]
  narrativeVersions  NarrativeVersion[]
  influencerCollabs  InfluencerCollab[]

  @@unique([propertyId, period])
  @@map("report_periods")
}

// ─── Executive summary / rooms ──────────────────────────────────────────────

/// Executive summary line items — actual vs budget vs last year, per department.
/// OCCUPANCY/ADR/REVPAR are stored here too (as ratios/amounts) alongside revenue.
model RevenueSummary {
  id         String     @id @default(cuid())
  periodId   String
  department Department
  // (18,4): money needs 2 dp; OCCUPANCY/ratios stored here need 4 dp so a
  // percentage renders to 2 dp precisely (e.g. 0.9483 → 94.83%).
  actual     Decimal    @db.Decimal(18, 4)
  budget     Decimal    @db.Decimal(18, 4)
  lastYear   Decimal?   @db.Decimal(18, 4)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, department])
  @@map("revenue_summaries")
}

/// Room production by market segment (MTD/YTD, actual/budget/last-year).
model SegmentProduction {
  id          String  @id @default(cuid())
  periodId    String
  scope       Scope
  segmentName String
  roomNights  Int
  arr         Decimal @db.Decimal(18, 2)
  roomRevenue Decimal @db.Decimal(18, 2)
  series      Series

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, scope, segmentName, series])
  @@map("segment_production")
}

/// Room production by room type (actual vs budget).
model RoomTypeProduction {
  id               String  @id @default(cuid())
  periodId         String
  roomTypeName     String
  roomNightsActual Int
  roomNightsBudget Int
  adrActual        Decimal @db.Decimal(18, 2)
  adrBudget        Decimal @db.Decimal(18, 2)
  revenueActual    Decimal @db.Decimal(18, 2)
  revenueBudget    Decimal @db.Decimal(18, 2)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, roomTypeName])
  @@map("room_type_production")
}

/// Room production by guest nationality (MTD/YTD).
model NationalityProduction {
  id                 String  @id @default(cuid())
  periodId           String
  scope              Scope
  countryCode        String?
  countryName        String
  roomNights         Int
  guests             Int?
  roomNightsLastYear Int?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, scope, countryName])
  @@map("nationality_production")
}

/// Length-of-stay distribution by nights bucket.
model LengthOfStay {
  id                 String @id @default(cuid())
  periodId           String
  /// "1", "2", "3", "4", "5", "6", "7+".
  losBucket          String
  bookings           Int
  roomNights         Int
  lastYearRoomNights Int?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, losBucket])
  @@map("length_of_stay")
}

/// Top account / channel production (YTD).
model AccountProduction {
  id          String      @id @default(cuid())
  periodId    String
  accountName String
  accountType AccountType
  roomNights  Int
  revenue     Decimal     @db.Decimal(18, 2)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, accountName])
  @@map("account_production")
}

// ─── Digital ads ─────────────────────────────────────────────────────────────

/// Paid advertising performance per business unit and platform.
model AdsPerformance {
  id             String       @id @default(cuid())
  periodId       String
  unit           BusinessUnit
  platform       AdsPlatform
  spend          Decimal      @db.Decimal(18, 2)
  impressions    Int
  clicks         Int
  reach          Int?
  trackedRevenue Decimal      @db.Decimal(18, 2)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, unit, platform])
  @@map("ads_performance")
}

// ─── Food & Beverage ─────────────────────────────────────────────────────────

/// Restaurant covers and revenue by meal period (actual vs budget).
model FnbSales {
  id            String     @id @default(cuid())
  periodId      String
  mealPeriod    MealPeriod
  coversActual  Int
  coversBudget  Int
  revenueActual Decimal    @db.Decimal(18, 2)
  revenueBudget Decimal    @db.Decimal(18, 2)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, mealPeriod])
  @@map("fnb_sales")
}

/// Restaurant covers/revenue by source of booking (e.g. Chope, Grab, in-house).
model FnbSourceOfBooking {
  id         String  @id @default(cuid())
  periodId   String
  sourceName String
  persons    Int
  revenue    Decimal @db.Decimal(18, 2)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, sourceName])
  @@map("fnb_source_of_booking")
}

/// Restaurant acquisition mix (share of bookings/covers by channel).
model FnbAcquisition {
  id          String     @id @default(cuid())
  periodId    String
  channel     FnbChannel
  bookingsPct Decimal    @db.Decimal(9, 4)
  coversPct   Decimal    @db.Decimal(9, 4)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, channel])
  @@map("fnb_acquisition")
}

/// Chope reservation-platform report (one per period).
model ChopeReport {
  id                String  @id @default(cuid())
  periodId          String
  fulfilledBookings Int
  fulfilledCovers   Int
  cancelledBookings Int
  cancelledCovers   Int
  noShows           Int
  revenue           Decimal @db.Decimal(18, 2)
  platformBookings  Int
  directBookings    Int

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId])
  @@map("chope_reports")
}

/// Gokai CRM / upsell report per business unit.
model GokaiReport {
  id                  String       @id @default(cuid())
  periodId            String
  unit                BusinessUnit
  signups             Int
  openRatePct         Decimal      @db.Decimal(9, 4)
  ctrPct              Decimal      @db.Decimal(9, 4)
  surveyCompletionPct Decimal      @db.Decimal(9, 4)
  productViews        Int
  upsellSales         Int
  upsellRevenue       Decimal      @db.Decimal(18, 2)
  refunds             Int

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, unit])
  @@map("gokai_reports")
}

// ─── Spa & Wellness ──────────────────────────────────────────────────────────

/// Spa covers and revenue by guest segment (actual vs budget).
model SpaSales {
  id            String          @id @default(cuid())
  periodId      String
  guestSegment  SpaGuestSegment
  coversActual  Int
  coversBudget  Int
  revenueActual Decimal         @db.Decimal(18, 2)
  revenueBudget Decimal         @db.Decimal(18, 2)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, guestSegment])
  @@map("spa_sales")
}

/// Top spa treatments by revenue.
model SpaTreatment {
  id             String  @id @default(cuid())
  periodId       String
  treatmentName  String
  treatmentCount Int
  revenue        Decimal @db.Decimal(18, 2)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, treatmentName])
  @@map("spa_treatments")
}

// ─── Online reputation ───────────────────────────────────────────────────────

/// OTA / review-platform ranking within the property's market.
model PlatformRanking {
  id            String          @id @default(cuid())
  periodId      String
  platform      RankingPlatform
  rank          Int
  totalInMarket Int?
  rating        Decimal?        @db.Decimal(3, 2)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, platform])
  @@map("platform_rankings")
}

/// Tripadvisor engagement metrics per business unit.
model TripadvisorMetrics {
  id            String       @id @default(cuid())
  periodId      String
  unit          BusinessUnit
  impressions   Int
  pageVisitors  Int
  newReviews    Int
  avgRating     Decimal      @db.Decimal(3, 2)
  websiteClicks Int
  phoneCalls    Int
  menuViews     Int?
  mapViews      Int

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, unit])
  @@map("tripadvisor_metrics")
}

// ─── Social media ────────────────────────────────────────────────────────────

/// Organic social-media metrics per business unit and platform.
model SocialMediaMetrics {
  id              String         @id @default(cuid())
  periodId        String
  unit            BusinessUnit
  platform        SocialPlatform
  impressions     Int
  reach           Int
  interactions    Int
  linkClicks      Int
  profileVisits   Int
  followersGained Int

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, unit, platform])
  @@map("social_media_metrics")
}

// ─── Market intelligence & forecast ──────────────────────────────────────────

/// Booking-pace snapshots: occupancy on the books for a target month.
model BookingPace {
  id                  String   @id @default(cuid())
  periodId            String
  snapshotDate        DateTime @db.Date
  targetMonth         DateTime @db.Date
  occupancyOnBooks    Decimal  @db.Decimal(9, 4)
  previousSnapshotOcc Decimal? @db.Decimal(9, 4)
  marketDemandPct     Decimal? @db.Decimal(9, 4)
  note                String

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, targetMonth, snapshotDate])
  @@map("booking_pace")
}

/// Six-month forward forecast per target month.
model Forecast {
  id              String   @id @default(cuid())
  periodId        String
  targetMonth     DateTime @db.Date
  forecastOccPct  Decimal  @db.Decimal(9, 4)
  lastYearOccPct  Decimal? @db.Decimal(9, 4)
  marketDemandPct Decimal? @db.Decimal(9, 4)
  forecastRevenue Decimal? @db.Decimal(18, 2)
  budgetRevenue   Decimal? @db.Decimal(18, 2)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, targetMonth])
  @@map("forecasts")
}

/// Competitive supply context for the property's market area.
model MarketSupply {
  id                      String  @id @default(cuid())
  periodId                String
  areaName                String
  propertiesCount         Int
  propertiesCountLastYear Int?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, areaName])
  @@map("market_supply")
}

// ─── Narrative & partnerships ────────────────────────────────────────────────

/// Free-text report narrative per section (may be AI-generated).
model NarrativeContent {
  id          String           @id @default(cuid())
  periodId    String
  section     NarrativeSection
  content     String           @db.Text
  aiGenerated Boolean          @default(false)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, section])
  @@map("narrative_content")
}

/// Append-only history of narrative edits (AI drafts, human edits, carry-forward).
model NarrativeVersion {
  id          String           @id @default(cuid())
  periodId    String
  section     NarrativeSection
  content     String           @db.Text
  aiGenerated Boolean          @default(false)
  /// Origin of this version: "ai", "human", or "carry_forward".
  source      String
  createdAt   DateTime         @default(now())

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, section])
  @@map("narrative_versions")
}

/// Audit log of monthly workbook imports (who, when, file, per-tab row counts).
model ImportHistory {
  id         String   @id @default(cuid())
  propertyId String
  period     DateTime @db.Date
  fileName   String
  uploadedBy String?
  rowCounts  Json
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, period])
  @@map("import_history")
}

/// Audit log of generated report exports (PPTX / PDF / group zip).
model ExportHistory {
  id         String   @id @default(cuid())
  /// Null for Group packs (multiple properties).
  propertyId String?
  period     DateTime @db.Date
  /// "pptx" | "pdf" | "group-zip".
  format     String
  /// "single" | "group".
  scope      String   @default("single")
  sections   Json?
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([propertyId, period])
  @@map("export_history")
}

/// Influencer / KOL collaborations for the month.
model InfluencerCollab {
  id        String  @id @default(cuid())
  periodId  String
  handle    String
  name      String
  followers Int
  origin    String
  notes     String?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, handle])
  @@map("influencer_collabs")
}

// ─── Auth, roles & audit (Phase 16) ──────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

/// App user. Credentials login uses `passwordHash`; Google SSO uses `accounts`.
model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               UserRole  @default(VIEWER)
  /// Property codes an EDITOR may write to (empty = none). Ignored for ADMIN.
  assignedProperties String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  // Weekly Reports module (shares the same users)
  weeklyReportsOwned WeeklyReport[]
  weeklyImports      WeeklyImport[]
  weeklyAiDrafts     WeeklyAiDraft[]

  @@map("users")
}

/// NextAuth OAuth account link (Google SSO).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// NextAuth database session (unused with JWT strategy, kept for the adapter).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// NextAuth email verification / magic-link tokens.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Activity audit trail: imports, narrative edits, exports, final locks, etc.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String?
  detail    Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Weekly Reports module ──────────────────────────────────────────────────
//
// A second reporting product in the same app: a weekly (Fri–Thu) Sales &
// Marketing report. It reuses Property and User above; every table here is
// prefixed `Weekly*` / mapped to `weekly_*` so it never clashes with the
// monthly Sales Highlight models. Derived metrics (ARR, variances, %, YTD) are
// computed in the calculation layer, except WeeklyMonthlyStat which stores the
// occupancy/ARR figures exactly as imported from VHP (occ as a 0–1 fraction).

/// Lifecycle of a weekly report. APPROVED and EXPORTED are locked (read-only).
enum WeeklyReportStatus {
  DRAFT
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  EXPORTED
}

/// One weekly report (Fri–Thu) for a property — parent of every section below.
model WeeklyReport {
  id         String             @id @default(cuid())
  propertyId String
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  year       Int
  weekNumber Int
  label      String?
  status     WeeklyReportStatus @default(DRAFT)
  ownerId    String?
  lockedAt   DateTime?
  exportedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  monthlyStats        WeeklyMonthlyStat[]
  segmentProductions  WeeklySegmentProduction[]
  rateCodeProductions WeeklyRateCodeProduction[]
  channelRns          WeeklyChannelRn[]
  ownerRepeaters      WeeklyOwnerRepeater[]
  ownerChannelMix     WeeklyOwnerChannelMix[]
  overviewBlocks      WeeklyOverviewBlock[]
  activities          WeeklyActivity[]
  socialMetrics       WeeklySocialMetric[]
  trainings           WeeklyTraining[]
  actionPlans         WeeklyActionPlan[]
  imports             WeeklyImport[]
  aiDrafts            WeeklyAiDraft[]
  screenshots         WeeklyScreenshot[]
  adsRoas             WeeklyAdsRoas[]

  @@unique([propertyId, startDate])
  @@index([propertyId, endDate])
  @@map("weekly_reports")
}

/// Yearly budget — one row per month per property (feeds Section B).
model WeeklyBudget {
  id         String   @id @default(cuid())
  propertyId String
  year       Int
  month      Int
  rnSold     Int      @default(0)
  /// Occupancy stored as a PERCENT (0–100), e.g. 72.500.
  occupancy  Decimal  @default(0) @db.Decimal(6, 3)
  arr        Decimal  @default(0) @db.Decimal(14, 2)
  revenue    Decimal  @default(0) @db.Decimal(16, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, year, month])
  @@map("weekly_budgets")
}

/// Reference list of market segments (Section C). propertyId null = global.
model WeeklyMarketSegment {
  id         String   @id @default(cuid())
  propertyId String?
  code       String
  name       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, code])
  @@map("weekly_market_segments")
}

/// Reference list of rate codes / promotions (Section D). propertyId null = global.
model WeeklyRateCode {
  id         String   @id @default(cuid())
  propertyId String?
  code       String
  name       String
  category   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, code])
  @@map("weekly_rate_codes")
}

/// Reference list of booking channels / sources (Sections E/F). propertyId null = global.
model WeeklyChannel {
  id         String   @id @default(cuid())
  propertyId String?
  code       String
  name       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, code])
  @@map("weekly_channels")
}

/// Key/value settings (AI model, language, branding). group: general|ai|import|branding.
model WeeklySetting {
  id         String   @id @default(cuid())
  propertyId String?
  group      String   @default("general")
  key        String
  value      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, group, key])
  @@map("weekly_settings")
}

/// Section B — per-month Actual/Budget/LY, snapshotted onto the week.
/// occ_* are fractions (0–1) exactly as imported; ARR/revenue in IDR.
model WeeklyMonthlyStat {
  id           String   @id @default(cuid())
  reportWeekId String
  month        Int
  rnSold       Int?
  occActual    Decimal? @db.Decimal(7, 4)
  occBudget    Decimal? @db.Decimal(7, 4)
  occLy        Decimal? @db.Decimal(7, 4)
  arrActual    Decimal? @db.Decimal(14, 2)
  arrBudget    Decimal? @db.Decimal(14, 2)
  arrLy        Decimal? @db.Decimal(14, 2)
  revActual    Decimal? @db.Decimal(16, 2)
  revBudget    Decimal? @db.Decimal(16, 2)
  revLy        Decimal? @db.Decimal(16, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportWeek WeeklyReport @relation(fields: [reportWeekId], references: [id], onDelete: Cascade)

  @@unique([reportWeekId, month])
  @@map("weekly_monthly_stats")
}

/// Section C — weekly production by market segment (last 7 days). ARR/% derived.
model WeeklySegmentProduction {
  id           String   @id @default(cuid())
  reportWeekId String
