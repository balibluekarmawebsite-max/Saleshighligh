/// Upload audit — each VHP / weekly-report file and how it was applied.
/// source: manual|vhp. status: pending|parsed|applied|failed.
model WeeklyImport {
  id               String    @id @default(cuid())
  userId           String?
  propertyId       String?
  reportWeekId     String?
  source           String    @default("manual")
  originalFilename String
  storedPath       String?
  status           String    @default("pending")
  periodLabel      String?
  summary          Json?
  warnings         Json?
  error            String?   @db.Text
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  property   Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reportWeek WeeklyReport? @relation(fields: [reportWeekId], references: [id], onDelete: SetNull)

  @@index([reportWeekId])
  @@map("weekly_imports")
}

/// Audit trail of AI (narrative) generations/rewrites for a week.
/// section: overview|activity|action_plan. mode: draft|rewrite|shorten|translate_en|translate_id.
model WeeklyAiDraft {
  id           String   @id @default(cuid())
  reportWeekId String
  section      String
  fieldKey     String?
  mode         String
  model        String
  output       String   @db.Text
  status       String   @default("draft")
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportWeek WeeklyReport @relation(fields: [reportWeekId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reportWeekId, section])
  @@map("weekly_ai_drafts")
}

/// Section SM — uploaded screenshots (Booking.com, Instagram, Facebook, etc.)
/// with a written or AI-generated summary. Images live on local disk
/// (lib/storage.ts); only the URL + storage key are persisted.
model WeeklyScreenshot {
  id           String   @id @default(cuid())
  reportWeekId String
  category     String   @default("other")
  title        String?
  imageUrl     String
  imageKey     String
  summary      String?  @db.Text
  aiGenerated  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportWeek WeeklyReport @relation(fields: [reportWeekId], references: [id], onDelete: Cascade)

  @@index([reportWeekId])
  @@map("weekly_screenshots")
}

/// Digital Ads & ROAS (pulled from the ads dashboard API, or entered manually).
/// One row per platform scope: "blended" (property totals; ROAS uses booked
/// `revenue`), "google" and "meta" (ROAS uses attributed `conversionValue`).
/// Raw inputs only; ROAS / CTR / CPC are computed in lib/weekly/calculations.
model WeeklyAdsRoas {
  id              String   @id @default(cuid())
  reportWeekId    String
  platform        String
  spend           Decimal? @db.Decimal(16, 2)
  revenue         Decimal? @db.Decimal(16, 2)
  conversionValue Decimal? @db.Decimal(16, 2)
  conversions     Decimal? @db.Decimal(14, 4)
  impressions     Int?
  clicks          Int?
  source          String   @default("manual")
  windowFrom      String?
  windowTo        String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reportWeek WeeklyReport @relation(fields: [reportWeekId], references: [id], onDelete: Cascade)

  @@unique([reportWeekId, platform])
  @@map("weekly_ads_roas")
}
