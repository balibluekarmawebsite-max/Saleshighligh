/// Sections E/F — Channel Inside (room nights): one row per source per year,
/// with 12 monthly columns. YTD/% derived.
model WeeklyChannelRn {
  id           String   @id @default(cuid())
  reportWeekId String
  year         Int
  sourceLabel  String
  jan          Int      @default(0)
  feb          Int      @default(0)
  mar          Int      @default(0)
  apr          Int      @default(0)
  may          Int      @default(0)
  jun          Int      @default(0)
  jul          Int      @default(0)
  aug          Int      @default(0)
  sep          Int      @default(0)
  oct          Int      @default(0)
  nov          Int      @default(0)
  dec          Int      @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportWeek WeeklyReport @relation(fields: [reportWeekId], references: [id], onDelete: Cascade)

  @@unique([reportWeekId, year, sourceLabel])
  @@map("weekly_channel_month_rn")
}

