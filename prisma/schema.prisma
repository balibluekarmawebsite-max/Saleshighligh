  segmentGroup String?
  rnSold       Int?
  grossRevenue Decimal? @db.Decimal(16, 2)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportWeek WeeklyReport @relation(fields: [reportWeekId], references: [id], onDelete: Cascade)

  @@index([reportWeekId])
  @@map("weekly_segment_productions")
}

