// BK Sales Dashboard — Prisma schema
//
// Local development uses SQLite (see DATABASE_URL in .env). The schema is kept
// Postgres-compatible: to move to production, change the datasource `provider`
// below to "postgresql" and point DATABASE_URL at your Postgres instance — no
// model changes required.
//
// Portability rules for this schema:
//   - No native `enum` types (unsupported on SQLite). Use String fields with a
//     documented set of allowed values instead.
//   - No Postgres-only scalar arrays or native types (e.g. no `String[]`).
//   - Money is stored in IDR as integers (the currency has no minor units in
//     practice). Use BigInt where values may exceed 2^31.
//
// This is intentionally minimal for the scaffolding phase — only foundational
// reference data (properties and their outlets) is modelled here. Analytics
// tables are added in later phases (see CLAUDE.md roadmap).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The three Blue Karma properties.
model Property {
  id        String   @id @default(cuid())
  /// Short code: "BKDS", "BKDU", or "BKV".
  code      String   @unique
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets Outlet[]

  @@map("properties")
}

/// Restaurant and spa outlets belonging to a property.
model Outlet {
  id         String   @id @default(cuid())
  propertyId String
  /// Outlet kind: "restaurant" or "spa".
  kind       String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, kind])
  @@index([propertyId])
  @@map("outlets")
}
