// BK Sales Dashboard — Prisma schema
//
// Database: Supabase (Postgres) for all environments.
//   - DATABASE_URL: the Supabase connection pooler (Supavisor, port 6543,
//     transaction mode) used by the app at runtime. Append `?pgbouncer=true`.
//   - DIRECT_URL:   a direct/session connection (port 5432) used by Prisma
//     Migrate and Introspect, which can't run through the transaction pooler.
// See .env.example for the exact connection-string formats.
//
// Conventions for this schema:
//   - Money is stored in IDR as integers (the currency has no minor units in
//     practice). Use BigInt where values may exceed 2^31.
//   - Now that we're Postgres-only, native `enum` types and scalar arrays are
//     available; introduce them in later phases where they add clarity.
//
// This is intentionally minimal for the scaffolding phase — only foundational
// reference data (properties and their outlets) is modelled here. Analytics
// tables are added in later phases (see CLAUDE.md roadmap).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The three Blue Karma properties.
model Property {
  id        String   @id @default(cuid())
  /// Short code: "BKDS", "BKDU", or "BKV".
  code      String   @unique
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets Outlet[]

  @@map("properties")
}

/// Restaurant and spa outlets belonging to a property.
model Outlet {
  id         String   @id @default(cuid())
  propertyId String
  /// Outlet kind: "restaurant" or "spa".
  kind       String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, kind])
  @@index([propertyId])
  @@map("outlets")
}
