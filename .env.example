# ── Database (Supabase / Postgres) ───────────────────────────────────────────
# Find these under Supabase → Project Settings → Database → "Connection string".
#
# DATABASE_URL — used by the app at runtime. Use the *Transaction* pooler
#   (Supavisor, host ...pooler.supabase.com, port 6543) and append
#   `?pgbouncer=true`. For serverless/edge also add `&connection_limit=1`.
#
# DIRECT_URL — used by Prisma Migrate/Introspect (they can't use the transaction
#   pooler). Use the *Session* pooler (same host, port 5432) or the direct
#   connection (host db.<project-ref>.supabase.co, port 5432).
#
# Both connection strings embed your database password — keep this file out of
# git (.env is gitignored; commit only this .env.example).

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── AI narrative generation (Phase 13) ───────────────────────────────────────
# Server-side only — never exposed to the browser. Without a credential, the
# "Generate with AI" buttons return a friendly "not configured" message.
#
# Pick ONE credential source (the SDK resolves them in this order):
#   1. ANTHROPIC_API_KEY   — your Anthropic API key (console.anthropic.com).
#   2. ANTHROPIC_AUTH_TOKEN — a short-lived OAuth token (e.g. from
#        `ant auth print-credentials --access-token`); must be refreshed.
#   3. `ant auth login` profile on disk — no key needed. Set
#        ANTHROPIC_USE_PROFILE=true so the route trusts the profile. Works for
#        LOCAL/self-hosted runs where the app runs as the logged-in user; NOT for
#        serverless/ephemeral hosts (no persistent profile) — use a key there.
#
# ANTHROPIC_MODEL — optional; defaults to claude-sonnet-4-6.

ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_USE_PROFILE="true"
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Report export (Phase 14) ─────────────────────────────────────────────────
# PPTX and the group zip work anywhere. PDF export runs headless Chromium via
# Playwright and needs a Node host with the browser available (not serverless):
#   npx playwright install chromium
# Optionally point at a specific Chromium binary if auto-detection fails:
# PLAYWRIGHT_CHROMIUM_PATH="/path/to/chromium"

# ── Auth (Phase 16) ──────────────────────────────────────────────────────────
# Route protection & role enforcement switch ON when AUTH_SECRET is set. Until
# then the app stays open (dev/preview) and all actions run as a synthetic admin.
#
# AUTH_SECRET  — random 32+ byte secret (generate: `openssl rand -base64 32`).
# AUTH_URL     — the deployed origin (e.g. https://dashboard.bluekarma.com).
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — optional, enables Google SSO.

AUTH_SECRET=""
# AUTH_URL="https://your-app.vercel.app"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# First admin bootstrap (used by `npm run db:create-admin`):
# ADMIN_EMAIL="ota@bluekarmasecrets.com"
# ADMIN_PASSWORD="change-me-strong"

# ── Image storage (Phase 16, Supabase Storage) ───────────────────────────────
# Used for uploaded images (promotions/plans). Bucket should be public.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."
# SUPABASE_STORAGE_BUCKET="uploads"
