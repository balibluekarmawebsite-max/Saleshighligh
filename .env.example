# ── Database (self-hosted PostgreSQL on your VPS) ────────────────────────────
# This project runs entirely on your own server — a local PostgreSQL instance,
# no external database service required. Create a database + role on the VPS
# (see DEPLOY.md §1), then point both URLs at it.
#
# DATABASE_URL — the app's runtime connection.
# DIRECT_URL   — used by Prisma Migrate. For a plain local Postgres (no external
#                connection pooler) this is the SAME value as DATABASE_URL.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
#   - host/port: 127.0.0.1:5432 is the Postgres default. If your instance
#     listens on another port (this VPS uses 5433), set it here.
#   - these strings embed your DB password — keep this file out of git
#     (.env is gitignored; commit only this .env.example).

DATABASE_URL="postgresql://bkapp:your-db-password@127.0.0.1:5432/bkdash?schema=public"
DIRECT_URL="postgresql://bkapp:your-db-password@127.0.0.1:5432/bkdash?schema=public"

# ── AI narrative generation (optional) ───────────────────────────────────────
# The only feature that calls an external service. Powers the "Generate with AI"
# buttons. WITHOUT a credential the app runs fine — those buttons simply return
# a friendly "not configured" message. Calls bill your Anthropic API account.
#
# Pick ONE credential source (the SDK resolves them in this order):
#   1. ANTHROPIC_API_KEY   — your Anthropic API key (console.anthropic.com).
#   2. ANTHROPIC_AUTH_TOKEN — a short-lived OAuth token; must be refreshed.
#   3. `claude` CLI login profile on disk — set ANTHROPIC_USE_PROFILE=true so the
#        route trusts it (works on a persistent VPS where the app runs as the
#        logged-in user).
#
# ANTHROPIC_MODEL — optional; defaults to claude-sonnet-4-6.

# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_USE_PROFILE="true"
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── AI data import (Groq — OpenAI-compatible) ────────────────────────────────
# Powers the AI-assisted Data Import: it reads a messy CSV / Excel / screenshot
# or pasted text for one section and arranges it into that section's report
# format. Uses Groq's OpenAI-compatible API. WITHOUT a key the AI import buttons
# return a friendly "not configured" message (the plain CSV/Excel import still
# works). Keep this key out of git — .env is gitignored.
#
# GROQ_API_KEY        — your Groq API key (console.groq.com/keys).
# GROQ_MODEL          — text/CSV/Excel model; defaults to openai/gpt-oss-120b.
# GROQ_VISION_MODEL   — screenshot (vision) model; defaults to qwen/qwen3.8-27b.
#                       Groq's vision lineup changes; if it 404s, list your
#                       account's models (GET https://api.groq.com/openai/v1/models)
#                       and set this to a current vision-capable one.
# GROQ_API_BASE       — optional endpoint override (default
#                       https://api.groq.com/openai/v1).

# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# ── Social Media (Metricool) ─────────────────────────────────────────────────
# Pulls Section H social metrics from Metricool. One Metricool login (one token
# + user id), with a brand assigned per property in the app (Settings → Social
# Media). WITHOUT a credential the manual Section H entry still works.
#
# All five metrics (followers + reach / impressions(views) / profile visits /
# website clicks) come from the v2 TIMELINES endpoint (/v2/analytics/timelines,
# subject=account): flow metrics sum the week's daily values, followers take the
# last day. The default metric names are already set in code from a live account
# (IG: reach / views / profile_views / website_clicks / followers; FB:
# page_media_view / pageViews / page_website_clicks_logged_in_unique /
# pageFollows; FB has no account-level reach). Override per account only if your
# names differ, via METRICOOL_METRIC_MAP (JSON) — no rebuild, just restart.
#
# Each brand must have its Instagram/Facebook connected in Metricool, and the
# property must point at that brand's blogId (Settings → Social Media). Inspect /
# discover an account with:
#   npx tsx scripts/metricool-discover.ts <propertyCode|blogId>   (full probe)
#   npx tsx scripts/metricool-discover.ts brands                  (connection map)
#   npx tsx scripts/metricool-discover.ts audit [extraBlogId…]    (follower counts)
#
# METRICOOL_USER_TOKEN — your Metricool API token (Account Settings → API).
# METRICOOL_USER_ID    — your Metricool user id (shown in the app URL / API).
# METRICOOL_API_BASE   — optional override (default https://app.metricool.com/api).
# METRICOOL_TIMEZONE   — optional, default Asia/Makassar (Bali, UTC+8).
# METRICOOL_TZ_OFFSET  — optional, default +08:00.
# METRICOOL_METRIC_MAP — optional JSON, per-network name overrides for any of the
#   five metrics (account_reached / impression / profile_visit / website_visit /
#   followers). Each value is {"metric":"…","subject":"account"} (or a bare string
#   = just the metric name; the default v2-timelines endpoint + reduce are kept).
#   Add "source"/"reduce" only to override the endpoint/reduction. Example:
#   METRICOOL_METRIC_MAP='{"instagram":{"impression":{"metric":"views"}},"facebook":{"impression":{"metric":"page_media_view"},"profile_visit":{"metric":"pageViews"}}}'

# METRICOOL_USER_TOKEN="..."
# METRICOOL_USER_ID="..."
# METRICOOL_METRIC_MAP=""

# ── Report export (PDF) ──────────────────────────────────────────────────────
# PPTX and the group zip work anywhere. PDF export renders headless Chromium via
# Playwright — install it once on the VPS:
#   npx playwright install --with-deps chromium
# Optionally point at a specific Chromium binary if auto-detection fails:
# PLAYWRIGHT_CHROMIUM_PATH="/path/to/chromium"

# ── Auth (turns ON login + role protection) ──────────────────────────────────
# Route protection & role enforcement switch ON when AUTH_SECRET is set. Until
# then the app stays open (dev) and all actions run as a synthetic admin. Set
# AUTH_SECRET before exposing the app publicly.
#
# AUTH_SECRET  — random 32+ byte secret (generate: `openssl rand -base64 32`).
# AUTH_URL     — the deployed origin (e.g. https://dashboard.bluekarmasecrets.com).

AUTH_SECRET=""
# AUTH_URL="https://dashboard.bluekarmasecrets.com"

# Google SSO (optional — email/password login works without it):
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# First admin bootstrap (used by `npm run db:create-admin`):
# ADMIN_EMAIL="ota@bluekarmasecrets.com"
# ADMIN_PASSWORD="change-me-strong"

# ── Weekly auto-sync (scheduled Metricool + ads pull) ────────────────────────
# A cron hits /api/cron/weekly-sync on a schedule (Friday 06:00 Bali time) to
# pull Metricool + ads for every property's current reporting week, creating the
# week's draft report if needed. The endpoint is gated by this secret — the
# scheduler sends it as `Authorization: Bearer <CRON_SECRET>`. WITHOUT it set,
# the endpoint refuses to run. See DEPLOY.md §9 for the crontab / systemd timer.
#
# CRON_SECRET — random secret (generate: `openssl rand -base64 32`).

# CRON_SECRET=""

# ── Image storage (local disk — no external service) ─────────────────────────
# Uploaded images (promotions / plans) are written to local disk and served by
# the app. Defaults work out of the box; override only to store uploads outside
# the repo tree (then serve that path with Caddy/nginx and match UPLOAD_URL_BASE).
# UPLOAD_DIR="public/uploads"
# UPLOAD_URL_BASE="/uploads"
