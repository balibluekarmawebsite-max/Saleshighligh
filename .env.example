# ── Database (Supabase / Postgres) ───────────────────────────────────────────
# Find these under Supabase → Project Settings → Database → "Connection string".
#
# DATABASE_URL — used by the app at runtime. Use the *Transaction* pooler
#   (Supavisor, host ...pooler.supabase.com, port 6543) and append
#   `?pgbouncer=true`. For serverless/edge also add `&connection_limit=1`.
#
# DIRECT_URL — used by Prisma Migrate/Introspect (they can't use the transaction
#   pooler). Use the *Session* pooler (same host, port 5432) or the direct
#   connection (host db.<project-ref>.supabase.co, port 5432).
#
# Both connection strings embed your database password — keep this file out of
# git (.env is gitignored; commit only this .env.example).

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── AI narrative generation (Phase 13) ───────────────────────────────────────
# Server-side only — never exposed to the browser. Without it, the "Generate
# with AI" buttons return a friendly "not configured" message.
#
# ANTHROPIC_API_KEY — your Anthropic API key (https://console.anthropic.com).
# ANTHROPIC_MODEL   — optional; defaults to claude-sonnet-4-6.

ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-6"
