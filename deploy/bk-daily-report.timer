[Unit]
Description=Send the BK Daily Occupancy Pick-Up email every morning (07:00 WITA)

[Timer]
# After the scraper's morning pulls land. Bali is UTC+8 (Asia/Makassar).
OnCalendar=*-*-* 07:00:00 Asia/Makassar
# Catch up a run the box missed while powered off.
Persistent=true

[Install]
WantedBy=timers.target
