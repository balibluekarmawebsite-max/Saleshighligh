# --- BK Sales Dashboard .env for a self-hosted VM (Oracle Cloud, etc.) ---
# Copy this to the project root as `.env` on the server, fill in the real values,
# then `chmod 600 .env`. Next.js loads it automatically; the systemd service
# picks it up on `sudo systemctl restart bk-dashboard`.

# --- Database (Supabase — already migrated) ------------------------------------
# Runtime connection via the Transaction pooler (port 6543, pgbouncer).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations via the Session pooler / direct connection (port 5432).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth (turns ON protection + roles) ----------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-string"
# Public origin the browser hits. Use your https domain once Caddy is up;
# for a quick IP-only test you can use http://<public-ip>:3000 (no HTTPS).
AUTH_URL="https://dashboard.example.com"

# --- Claude / AI narrative -----------------------------------------------------
# Simplest: a server-side API key (billed to your Anthropic API account).
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (defaults to claude-sonnet-4-6):
# ANTHROPIC_MODEL="claude-sonnet-4-6"
#
# Alternative to the key: log in once with the Claude CLI on the server
# (`npx @anthropic-ai/claude-code auth login`) and set:
# ANTHROPIC_USE_PROFILE="true"
# (still billed to the Anthropic API account — it is an auth convenience, not a
#  way to bill a Claude.ai subscription.)

# --- Google SSO (optional) -----------------------------------------------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Image storage (optional) --------------------------------------------------
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="uploads"
