# --- BK Sales Dashboard .env for a self-hosted VPS (fully self-contained) ------
# Copy this to the project root as `.env` on the server, fill in the real values,
# then `chmod 600 .env`. Next.js loads it automatically; the systemd service
# picks it up on `sudo systemctl restart bk-dashboard`.

# --- Database (local PostgreSQL on this VPS) -----------------------------------
# A plain local Postgres instance. Both URLs point at the same local database
# (no external connection pooler). Create the role + database + grants first —
# see DEPLOY.md §1. Set the port to match your Postgres (default 5432; this
# server uses 5433).
DATABASE_URL="postgresql://bkapp:your-db-password@127.0.0.1:5432/bkdash?schema=public"
DIRECT_URL="postgresql://bkapp:your-db-password@127.0.0.1:5432/bkdash?schema=public"

# --- Auth (turns ON protection + roles) ----------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-string"
# Public origin the browser hits. Use your https domain once Caddy is up;
# for a quick IP-only test you can use http://<public-ip>:3000 (no HTTPS).
AUTH_URL="https://dashboard.bluekarmasecrets.com"

# --- Claude / AI narrative (optional) ------------------------------------------
# The one external service. Without it, "Generate with AI" shows "not configured"
# and everything else works. Simplest: a server-side API key.
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (defaults to claude-sonnet-4-6):
# ANTHROPIC_MODEL="claude-sonnet-4-6"
#
# Alternative to the key: log in once with the Claude CLI on the server
# (`npx @anthropic-ai/claude-code auth login`) and set:
# ANTHROPIC_USE_PROFILE="true"
# (still billed to the Anthropic API account — an auth convenience, not a way to
#  bill a Claude.ai subscription.)

# --- Google SSO (optional) -----------------------------------------------------
# Email/password login works without this.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Image storage (local disk — no external service) --------------------------
# Defaults write to public/uploads and serve at /uploads. Override only to store
# uploads outside the repo (then serve that path with Caddy and match the base).
# UPLOAD_DIR="public/uploads"
# UPLOAD_URL_BASE="/uploads"
